# dbt Project Environment Variables
# Copy this file to .env and update with your actual values

# Current environment (development, staging, production)
DBT_ENV=development

# Development environment
S3_SOURCE_BUCKET_DEV=s3://dev-raw-data/
DEST_S3_BUCKET_DEV=s3://dev-iceberg-warehouse/
DLQ_S3_BUCKET_DEV=s3://dev-iceberg-dlq/
DBT_THREADS_DEV=2

# Staging environment
S3_SOURCE_BUCKET_STAGING=s3://staging-raw-data/
DEST_S3_BUCKET_STAGING=s3://staging-iceberg-warehouse/
DLQ_S3_BUCKET_STAGING=s3://staging-iceberg-dlq/
DBT_THREADS_STAGING=3

# Production environment
S3_SOURCE_BUCKET_PROD=s3://prod-raw-data/
DEST_S3_BUCKET_PROD=s3://prod-iceberg-warehouse/
DLQ_S3_BUCKET_PROD=s3://prod-iceberg-dlq/
DBT_THREADS_PROD=4

# AWS credentials (optional - use IAM roles in production)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# DuckDB settings
DUCKDB_DATABASE_PATH=/tmp/iceberg.duckdb

# dbt settings
DBT_PROFILES_DIR=~/.dbt
DBT_MODELS_DIR=models
DBT_TEST_NEW_TYPES=true
